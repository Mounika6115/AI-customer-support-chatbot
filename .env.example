FLASK_ENV=development
# IMPORTANT: Generate strong, random secrets for production!
# You can generate them with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER use these demo values in production.
SECRET_KEY=generate-a-strong-random-secret-here-min-32-chars
JWT_SECRET_KEY=generate-a-strong-random-jwt-secret-here-min-32-chars
# Default zero-config DB (SQLite). Persistent app data lives in the DB, not localStorage.
DATABASE_URL=sqlite:///support.db
# Production / MySQL preference (requires PyMySQL, already in requirements.txt):
# DATABASE_URL=mysql+pymysql://support:support123@localhost:3306/supportdb
# Serverless (Vercel) note: the repo SQLite file is READ-ONLY in production,
# so the backend automatically uses sqlite:////tmp/support.db there (fresh
# seed on cold start, ephemeral). For persistent data set DATABASE_URL to a
# hosted DB instead, e.g. Neon/Supabase Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/supportdb
# (then add psycopg2-binary to backend/requirements.txt).
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3-flash-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
# Must list every frontend origin or browsers block the chat POSTs (CORS).
# Prefer an explicit allowlist (do NOT use "*" for the main app in production).
# CORS_ORIGINS=https://ai-customer-support-chatbot-r89k.vercel.app,https://ai-customer-support-chatbot-orcin.vercel.app,http://localhost:5173,http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Evaluation endpoints (/api/eval/*) are disabled by default.
# To enable only for trusted harnesses:
#   EVAL_ENABLED=1
#   EVAL_KEY=<long-random-shared-secret>  (required)
#   EVAL_CORS_ORIGINS=http://localhost:5173  (must not be "*")
#   EVAL_ALLOW_LIVE=1  (optional; forces live models only if opted in)
#   EVAL_ALLOW_WRITES=1  (optional; DO NOT enable to protect seeded demo data)
# Evaluation is NEVER enabled when ENV/FLASK_ENV/VERCEL_ENV indicate production
# or when running in serverless environments.
